[Unit]
Description=Solar history load (7-day X-ray/Kp/SFI refresh)
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
# Site paths. The binaries ship none; see /etc/ionis/paths.conf.
# Leading "-" so a host that has not been configured yet fails in the tool, with a
# message naming the variable, rather than in systemd with a missing-file error.
EnvironmentFile=-/etc/ionis/paths.conf
Type=oneshot
ExecStart=/usr/bin/solar-history-load --download
User=ionis-ingest
Group=ionis-data
