# Ingest half of the WSPR pipeline: local .jsonl.gz -> wspr.bronze, with watermark.
#
# Runs after wspr-live-download. Idempotent on two keys: the ingest_log watermark skips
# unchanged files outright, and an id-set skips rows already held when a settling day's
# file has grown. wspr.bronze is a plain MergeTree with no dedup, so the second key is
# load-bearing, not defensive.
[Unit]
Description=WSPR spot ingest from local archive into ClickHouse
After=network-online.target clickhouse-server.service wspr-live-download.service
Wants=network-online.target

[Service]
# Site paths. The binaries ship none; see /etc/ionis-apps/paths.conf.
# Leading "-" so a host that has not been configured yet fails in the tool, with a
# message naming the variable, rather than in systemd with a missing-file error.
EnvironmentFile=-/etc/ionis-apps/paths.conf
Type=oneshot
User=ionis-ingest
Group=ionis-data
ExecStart=/usr/bin/wspr-live-ingest -src ${IONIS_WSPR_LIVE_DIR} -host ${IONIS_CH_HOST}
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600
Restart=no
