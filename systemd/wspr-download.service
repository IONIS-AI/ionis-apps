# Legacy wsprnet.org archive downloader, kept for rebuilds of the historical archive.
# The nightly pipeline is wspr-live-download/-ingest; this one is run deliberately.
#
# Packaged in 4.0.8. It and solar-backfill were the two units missed when the other
# nine moved into this package in 4.0.5 (KI7MT/fleet-ops#183).
[Unit]
Description=WSPR archive download (ETag-based, idempotent)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/wspr-download
User=ionis-ingest
Group=ionis-data
StandardOutput=journal
StandardError=journal
